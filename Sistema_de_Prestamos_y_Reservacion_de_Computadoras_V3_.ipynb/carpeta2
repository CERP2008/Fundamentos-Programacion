        "# ========================================\n",
        "# SISTEMA DE PRÉSTAMOS\n",
        "# Versión final completa con matriz de alumnos,\n",
        "# historial de préstamos y necesidades de software\n",
        "# ========================================\n",
        "\n",
        "import datetime\n",
        "\n",
        "# 1. Lista de alumnos actualizada como matriz (Control, Nombre, Carrera)\n",
        "alumnos = [\n",
        "    [\"26040200\", \"Juan\", \"Ingenieria en Sistemas Computacionales\"],\n",
        "    [\"26040201\", \"Pedro\", \"Ingenieria en inteligencia Artificial\"],\n",
        "    [\"26040202\", \"Paola\", \"TICS\"],\n",
        "    [\"26040203\", \"Karen\", \"Ingenieria en Sistemas Computacionales\"],\n",
        "    [\"26040204\", \"Jose\", \"Ingenieria en Sistemas Computacionales\"],\n",
        "    [\"26040205\", \"Maria\", \"Ingenieria en Sistemas Computacionales\"],\n",
        "    [\"26040206\", \"Luis\", \"Ingenieria en Sistemas Computacionales\"],\n",
        "    [\"26041221\", \"Carlos\", \"Ingenieria en Sistemas Computacionales\"]\n",
        "]\n",
        "\n",
        "# Cada sublista en computadoras contiene: [ID, Aula, Software, Estado]\n",
        "computadoras = [\n",
        "    [\"PC-LC1-01\", \"LC1\", \"Python, VS Code\", \"Disponible\"],\n",
        "    [\"PC-LC1-02\", \"LC1\", \"Python, Java, VS Code\", \"Prestada\"],\n",
        "    [\"PC-LC1-03\", \"LC1\", \"AutoCAD, MATLAB\", \"Reservada\"],\n",
        "    [\"PC-LC2-01\", \"LC2\", \"Python, VS Code\", \"Disponible\"],\n",
        "    [\"PC-LC2-02\", \"LC2\", \"Python, Java, VS Code\", \"Prestada\"],\n",
        "    [\"PC-LC2-03\", \"LC2\", \"AutoCAD, MATLAB\", \"Disponible\"],\n",
        "    [\"PC-LC3-01\", \"LC3\", \"Python, VS Code\", \"Disponible\"],\n",
        "    [\"PC-LC3-02\", \"LC3\", \"Python, Java, VS Code\", \"Prestada\"],\n",
        "    [\"PC-LC3-03\", \"LC3\", \"AutoCAD, MATLAB\", \"Reservada\"],\n",
        "    [\"PC-LC3-04\", \"LC3\", \"Python, VS Code\", \"Mantenimiento\"]\n",
        "]\n",
        "\n",
        "# Listas globales para los historiales\n",
        "prestamos = []\n",
        "necesidades_software = []\n",
        "\n",
        "\n",
        "def listar_computadoras():\n",
        "    print(\"\\n--- COMPUTADORAS ---\")\n",
        "    for i in range(len(computadoras)):\n",
        "        print(f\"{i+1}. Aula: {computadoras[i][1]} | ID: {computadoras[i][0]} | Software: {computadoras[i][2]} | Estado: {computadoras[i][3]}\")\n",
        "\n",
        "\n",
        "def buscar_sw():\n",
        "    programa = input(\"\\nIngrese el software que desea buscar: \")\n",
        "    print(\"\\n--- RESULTADOS ---\")\n",
        "    encontrado = False\n",
        "    for i in range(len(computadoras)):\n",
        "        if programa.lower() in computadoras[i][2].lower():\n",
        "            print(f\"ID: {computadoras[i][0]} | Aula: {computadoras[i][1]} | Software: {computadoras[i][2]} | Estado: {computadoras[i][3]}\")\n",
        "            encontrado = True\n",
        "\n",
        "    if not encontrado:\n",
        "        print(\"No se encontraron computadoras con ese software.\")\n",
        "\n",
        "\n",
        "def solicitar_prestamo():\n",
        "    print(\"\\n=== SOLICITAR PRÉSTAMO ===\")\n",
        "    num_control = input(\"Número de control del alumno: \").strip()\n",
        "\n",
        "    # Validar el alumno recorriendo la matriz (comparando con la columna 0)\n",
        "    alumno_encontrado = False\n",
        "    for i in range(len(alumnos)):\n",
        "        if alumnos[i][0] == num_control:\n",
        "            alumno_encontrado = True\n",
        "            break\n",
        "\n",
        "    if alumno_encontrado:\n",
        "        programa = input(\"¿Qué programa necesita?: \")\n",
        "        asignado = False\n",
        "        programa_existe_en_pc = False\n",
        "\n",
        "        for i in range(len(computadoras)):\n",
        "            if programa.lower() in computadoras[i][2].lower():\n",
        "                programa_existe_en_pc = True\n",
        "                if computadoras[i][3] == \"Disponible\":\n",
        "                    computadoras[i][3] = \"Prestada\"\n",
        "\n",
        "                    # Registrar información del préstamo: [Alumno, Software, Aula, ID]\n",
        "                    nuevo_prestamo = [num_control, programa, computadoras[i][1], computadoras[i][0]]\n",
        "                    prestamos.append(nuevo_prestamo)\n",
        "\n",
        "                    print(f\"Se asignó la computadora {computadoras[i][0]} que está en el aula {computadoras[i][1]}.\")\n",
        "                    asignado = True\n",
        "                    break\n",
        "                else:\n",
        "                    print(f\"La computadora {computadoras[i][0]} tiene el software pero está: {computadoras[i][3]}\")\n",
        "\n",
        "        # Si el programa no existe en ninguna computadora, preguntar si desea agregarlo a necesidades\n",
        "        if not programa_existe_en_pc and not asignado:\n",
        "            print(f\"\\nEl programa '{programa}' no se encuentra en ninguna computadora.\")\n",
        "            confirmacion = input(\"¿Desea agregarlo a la lista de necesidades de software? (s/n): \").strip().lower()\n",
        "            if confirmacion == 's':\n",
        "                # Obtener la fecha y hora actual con el módulo datetime\n",
        "                fecha_hora_actual = datetime.datetime.now().strftime(\"%d/%m/%Y %H:%M:%S\")\n",
        "                necesidades_software.append([programa, fecha_hora_actual])\n",
        "                print(\"¡Programa agregado a la lista de necesidades con éxito!\")\n",
        "            else:\n",
        "                print(\"No se agregó a la lista de necesidades.\")\n",
        "    else:\n",
        "        print(\"El alumno no existe en la lista de alumnos activos.\")\n",
        "\n",
        "\n",
        "def devolver_computadora():\n",
        "    print(\"\\n=== DEVOLVER COMPUTADORA ===\")\n",
        "    id_pc = input(\"Ingrese el ID de la computadora: \")\n",
        "    existe = False\n",
        "    for i in range(len(computadoras)):\n",
        "        if computadoras[i][0] == id_pc:\n",
        "            existe = True\n",
        "            if computadoras[i][3] in [\"Prestada\", \"Reservada\"]:\n",
        "                computadoras[i][3] = \"Disponible\"\n",
        "                print(f\"La computadora {id_pc} ya está disponible.\")\n",
        "            else:\n",
        "                print(f\"La computadora {id_pc} no está prestada ni reservada (Estado actual: {computadoras[i][3]}).\")\n",
        "            break\n",
        "\n",
        "    if not existe:\n",
        "        print(f\"No existe la computadora {id_pc}.\")\n",
        "\n",
        "\n",
        "def crear_reservacion():\n",
        "    print(\"\\n=== CREAR RESERVACIÓN ===\")\n",
        "    num_control = input(\"Número de control del alumno: \").strip()\n",
        "\n",
        "    # Validar alumno con la matriz\n",
        "    alumno_encontrado = False\n",
        "    for i in range(len(alumnos)):\n",
        "        if alumnos[i][0] == num_control:\n",
        "            alumno_encontrado = True\n",
        "            break\n",
        "\n",
        "    if alumno_encontrado:\n",
        "        id_pc = input(\"Ingrese el ID de la computadora a reservar: \")\n",
        "        existe = False\n",
        "        for i in range(len(computadoras)):\n",
        "            if computadoras[i][0] == id_pc:\n",
        "                existe = True\n",
        "                if computadoras[i][3] == \"Disponible\":\n",
        "                    computadoras[i][3] = \"Reservada\"\n",
        "                    print(f\"La computadora {id_pc} ha sido reservada con éxito.\")\n",
        "                else:\n",
        "                    print(f\"La computadora {id_pc} no se puede reservar (Estado actual: {computadoras[i][3]}).\")\n",
        "                break\n",
        "        if not existe:\n",
        "            print(f\"No existe la computadora {id_pc}.\")\n",
        "    else:\n",
        "        print(\"El alumno no existe en la lista de alumnos activos.\")\n",
        "\n",
        "\n",
        "def agregar_computadora():\n",
        "    print(\"\\n--- AGREGAR COMPUTADORA ---\")\n",
        "    id_computadora = input(\"ID de la computadora: \")\n",
        "    aula = input(\"Aula: \")\n",
        "    programas = input(\"Software instalado: \")\n",
        "\n",
        "    computadoras.append([id_computadora, aula, programas, \"Disponible\"])\n",
        "    print(\"\\nComputadora agregada correctamente.\")\n",
        "\n",
        "\n",
        "def mostrar_historial_prestamos():\n",
        "    print(\"\\n--- HISTORIAL DE PRESTAMOS DE COMPUTADORAS ---\")\n",
        "    if len(prestamos) == 0:\n",
        "        print(\"No hay préstamos registrados.\")\n",
        "    else:\n",
        "        for i in range(len(prestamos)):\n",
        "            print(f\"{i + 1} | Alumno: {prestamos[i][0]} | Software: {prestamos[i][1]} | Aula: {prestamos[i][2]} | ID: {prestamos[i][3]}\")\n",
        "\n",
        "\n",
        "def mostrar_necesidades_software():\n",
        "    print(\"\\n--- HISTORIAL DE NECESIDADES ---\")\n",
        "    if len(necesidades_software) == 0:\n",
        "        print(\"No hay necesidades de software registradas.\")\n",
        "    else:\n",
        "        for i in range(len(necesidades_software)):\n",
        "            print(f\"{i + 1} | Programa: {necesidades_software[i][0]} | Fecha: {necesidades_software[i][1]} |\")\n",
        "\n",
        "\n",
        "def estadisticas():\n",
        "    print(\"\\n======= Estadisticas por programa ===========\")\n",
        "    conteo_programas = []\n",
        "    for i in range(len(prestamos)):\n",
        "        software = prestamos[i][1]\n",
        "        encontrado = False\n",
        "        for j in range(len(conteo_programas)):\n",
        "            if conteo_programas[j][0].lower() == software.lower():\n",
        "                conteo_programas[j][1] += 1\n",
        "                encontrado = True\n",
        "                break\n",
        "        if not encontrado:\n",
        "            conteo_programas.append([software, 1])\n",
        "\n",
        "    if len(conteo_programas) == 0:\n",
        "        print(\"No hay registros de préstamos para calcular estadísticas de programas.\")\n",
        "    else:\n",
        "        for cp in conteo_programas:\n",
        "            print(f\"{cp[0]} : {cp[1]} veces\")\n",
        "\n",
        "    print(\"\\n======= Estadísticas por carrera ===========\")\n",
        "    conteo_carreras = []\n",
        "    for i in range(len(prestamos)):\n",
        "        num_control = prestamos[i][0]\n",
        "        carrera = \"\"\n",
        "        for j in range(len(alumnos)):\n",
        "            if alumnos[j][0] == num_control:\n",
        "                carrera = alumnos[j][2]\n",
        "                break\n",
        "\n",
        "        if carrera:\n",
        "            encontrado = False\n",
        "            for k in range(len(conteo_carreras)):\n",
        "                if conteo_carreras[k][0] == carrera:\n",
        "                    conteo_carreras[k][1] += 1\n",
        "                    encontrado = True\n",
        "                    break\n",
        "            if not encontrado:\n",
        "                conteo_carreras.append([carrera, 1])\n",
        "\n",
        "    if len(conteo_carreras) == 0:\n",
        "        print(\"No hay registros de préstamos para calcular estadísticas de carreras.\")\n",
        "    else:\n",
        "        for cc in conteo_carreras:\n",
        "            print(f\"{cc[0]} : {cc[1]} veces\")\n",
        "\n",
        "\n",
        "# MENÚ PRINCIPAL\n",
        "opcion = 0\n",
        "while opcion != 10:\n",
        "    print(\"\\n================================\")\n",
        "    print(\"      SISTEMA DE PRÉSTAMOS\")\n",
        "    print(\"================================\")\n",
        "    print(\"1. Consultar computadoras\")\n",
        "    print(\"2. Buscar por software\")\n",
        "    print(\"3. Solicitar préstamo\")\n",
        "    print(\"4. Devolver computadora\")\n",
        "    print(\"5. Crear reservación\")\n",
        "    print(\"6. Agregar computadora\")\n",
        "    print(\"7. Historial de prestamos\")\n",
        "    print(\"8. Necesidades de Software\")\n",
        "    print(\"9. Estadisticas\")\n",
        "    print(\"10. Salir\")\n",
        "    print(\"================================\")\n",
        "\n",
        "    try:\n",
        "        opcion = int(input(\"Seleccione una opción: \"))\n",
        "    except ValueError:\n",
        "        print(\"\\nPor favor, ingrese un número válido.\")\n",
        "        continue\n",
        "\n",
        "    if opcion == 1:\n",
        "        listar_computadoras()\n",
        "    elif opcion == 2:\n",
        "        buscar_sw()\n",
        "    elif opcion == 3:\n",
        "        solicitar_prestamo()\n",
        "    elif opcion == 4:\n",
        "        devolver_computadora()\n",
        "    elif opcion == 5:\n",
        "        crear_reservacion()\n",
        "    elif opcion == 6:\n",
        "        agregar_computadora()\n",
        "    elif opcion == 7:\n",
        "        mostrar_historial_prestamos()\n",
        "    elif opcion == 8:\n",
        "        mostrar_necesidades_software()\n",
        "    elif opcion == 9:\n",
        "        estadisticas()\n",
        "    elif opcion == 10:\n",
        "        print(\"\\nGracias por utilizar el sistema.\")\n",
        "        break\n",
        "    else:\n",
        "        print(\"\\nOpción no válida. Intente nuevamente.\")"
