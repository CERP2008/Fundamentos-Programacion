        "## Calcular el área de un triángulo"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "052bd595",
        "outputId": "50eb3278-d9ac-4309-cfcd-5c15d5786658"
      },
      "source": [
        "# Solicitar la base y la altura al usuario\n",
        "base = float(input(\"Introduce la longitud de la base del triángulo: \"))\n",
        "altura = float(input(\"Introduce la altura del triángulo: \"))\n",
        "\n",
        "# Calcular el área\n",
        "area = (base * altura) / 2\n",
        "\n",
        "# Mostrar el resultado\n",
        "print(f\"El área del triángulo es: {area}\")"
      ],
      "execution_count": 1,
      "outputs": [
